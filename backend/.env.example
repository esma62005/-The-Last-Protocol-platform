# Copy to .env and fill in. In production (ENVIRONMENT=production) the server REFUSES to start if
# SECRET_KEY is weak/default or ADMIN_PASSWORD is a placeholder.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://hackathon:hackathon@localhost:5432/hackathon
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_with_at_least_32_random_characters
CORS_ORIGINS=http://localhost:3000
DEFAULT_CAPACITY=50

# Main admin (created / synced at every start). Use a long random password.
ADMIN_EMAIL=CHANGE_ME@example.com
ADMIN_PASSWORD=CHANGE_ME_long_random_password

# Cookies (production: Secure is forced on). Front-end and API must share the same site (e.g. app.x.dz + api.x.dz).
# COOKIE_SAMESITE=lax
# Set to true only behind your own reverse proxy so the real client IP is used for login rate limiting.
# TRUST_PROXY_HEADERS=false

# --- Notification e-mails: sent FROM the admin address ---
# Leave SMTP_HOST empty in development: e-mails are only printed in the server logs.
SITE_URL=http://localhost:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# defaults to ADMIN_EMAIL when empty
SMTP_USER=
# Google App Password of the sender account (NOT the normal Gmail password)
SMTP_PASSWORD=
# defaults to the admin address when empty
MAIL_FROM=
